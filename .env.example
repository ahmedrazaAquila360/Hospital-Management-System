# Dedicated hospital PostgreSQL database
HOSPITAL_DATABASE_URL="postgresql://user:password@localhost:5432/hospital_management_mvp?schema=public"

# Required only when creating synthetic development accounts.
# Choose a development password of at least 16 characters.
HOSPITAL_DEMO_PASSWORD=""

# Optional persistent directory for private patient photos and local documents.
# HOSPITAL_UPLOAD_DIR="/absolute/path/to/private/hospital-files"

# Optional dedicated private R2 storage for hospital documents.
# HOSPITAL_R2_ACCOUNT_ID=""
# HOSPITAL_R2_ACCESS_KEY_ID=""
# HOSPITAL_R2_SECRET_ACCESS_KEY=""
# HOSPITAL_R2_BUCKET=""
