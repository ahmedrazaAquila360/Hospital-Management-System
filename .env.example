# Dedicated hospital PostgreSQL database
HOSPITAL_DATABASE_URL="postgresql://user:password@localhost:5432/hospital_management_mvp?schema=public"

# Required in production; random secret with at least 32 bytes. Never commit the value.
HOSPITAL_AUTH_HMAC_KEY=""
# Optional sign-in limits (defaults: 5 failures, 15-minute window, 15-minute lock).
# HOSPITAL_LOGIN_MAX_FAILURES="5"
# HOSPITAL_LOGIN_WINDOW_MINUTES="15"
# HOSPITAL_LOGIN_LOCK_MINUTES="15"

# Required only when creating synthetic development accounts.
# Choose a development password of at least 16 characters.
HOSPITAL_DEMO_PASSWORD=""

# Optional persistent directory for private patient photos and local documents.
# HOSPITAL_UPLOAD_DIR="/absolute/path/to/private/hospital-files"

# Optional dedicated private R2 storage for hospital documents.
# HOSPITAL_R2_ACCOUNT_ID=""
# HOSPITAL_R2_ACCESS_KEY_ID=""
# HOSPITAL_R2_SECRET_ACCESS_KEY=""
# HOSPITAL_R2_BUCKET=""

# Exact public HTTPS origin used for R2 CORS verification.
# HOSPITAL_APP_ORIGIN="https://hospital.example.com"
# Signed branch display links; use a separate random secret (32+ characters).
# HOSPITAL_WAITING_BOARD_KEY=""
# Protected reminder-job and health endpoints; random secret (32+ characters).
# HOSPITAL_JOB_TOKEN=""

# Backup configuration. Keep the encryption key separately from backup files.
# HOSPITAL_BACKUP_KEY="" # base64-encoded 32 random bytes
# HOSPITAL_BACKUP_DIR="/private/persistent/hospital-backups"
# Empty staging database only; never point restore at a database containing records.
# HOSPITAL_RESTORE_DATABASE_URL=""
